{
  "name": "community-platform",
  "buildCommand": "npx prisma generate && npm run build",
  "installCommand": "npm install",
  "outputDirectory": "./.next",
  "nodeVersion": "22.11.0",
  "env": {
    "DATABASE_URL": "",
    "NEXTAUTH_SECRET": "",
    "NEXTAUTH_URL": "",
    "APP_NAME": "社群主理人平台",
    "APP_DESCRIPTION": "连接主理人，发现精彩活动"
  },
  "cloudFunctions": {
    "nodejs": {
      "externalNodeModules": [
        "@prisma/client",
        "bcryptjs",
        "jsonwebtoken"
      ],
      "includeFiles": [
        "prisma/schema.prisma",
        ".env",
        "lib/**"
      ],
      "maxDuration": 60
    },
    "mainlandRegions": ["ap-guangzhou"],
    "overseasRegions": ["ap-singapore"]
  },
  "headers": [
    {
      "source": "/*",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/_next/static/*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "max-age=31536000"
        }
      ]
    }
  ]
}
